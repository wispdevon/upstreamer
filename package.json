{
  "name": "upstreamer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types scripts/package-skill.mjs && vite",
    "build": "node --experimental-strip-types scripts/package-skill.mjs && tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "node --experimental-strip-types scripts/package-skill.mjs && vitest run",
    "test:e2e": "playwright test",
    "skill:package": "node --experimental-strip-types scripts/package-skill.mjs",
    "preview": "vite preview",
    "deploy:check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e && pnpm build",
    "deploy": "pnpm deploy:check && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^1.58.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fflate": "^0.8.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.28.5"
}
